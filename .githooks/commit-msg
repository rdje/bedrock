#!/usr/bin/env bash
# .githooks/commit-msg — the same enforcer, now WITH the message: the subject shape, the
# no-agent-trailer rule (COMMIT.md), and — from REVIEW-2026-09.4 — the leaf the subject names
# bound to the change. Identical in CI per commit, so --no-verify buys nothing durable.
set -u
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "commit-msg: REFUSED — git rev-parse failed" >&2; exit 2; }
exec bash "$ROOT/scripts/check_doctrines.sh" --message "$1"
